{
  "name": "chat-with-cv",
  "version": "1.0.0",
  "type": "python",
  "entrypoint": "cvv1.py",
  "start_command": "uvicorn main:app --host 0.0.0.0 --port $PORT",
  "ports": [
    {"port": 8000,"protocol": "http"}
  ],
  "dependencies": [
    "fastapi",
    "uvicorn",
    "python-multipart",
    "sentence-transformers",
    "langchain-text-splitters",
    "pymupdf4llm",
    "google-generativeai"
  ],
  "env": {
    "GENAI_API_KEY": {"description": "Gemini API Key", "required": true}
  }
}
